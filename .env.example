# App (for Stripe redirects and links)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# OFFICE_TIMEZONE=Europe/Rome  ← use for slot/calendar (e.g. Europe/Rome)

# Supabase (free tier) — required for services, slots, and bookings. See docs/SETUP_STEP_BY_STEP.md
# NEXT_PUBLIC_SUPABASE_URL=   ← Project URL (Primary Database / RESTful endpoint) from Supabase → Settings → API
# SUPABASE_SERVICE_ROLE_KEY=  ← service_role SECRET key (JWT, eyJ...). Do NOT use the publishable key (sb_publishable_...).
# DATABASE_URL=               ← Optional. Postgres URI from Supabase → Settings → Database → Connection string (URI). Lets you run npm run db:fix-arabic from CLI.

# Stripe (payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Video meetings (free by default)
# Default: Jitsi Meet (free, no key). Links: https://meet.jit.si/StudioCAS-{id}
# Optional paid: set DAILY_API_KEY to use Daily.co instead
# DAILY_API_KEY=
# DAILY_APP_URL=

# Email (Brevo — brevo.com, formerly Sendinblue)
# Get API key: Brevo → SMTP & API → API Keys (use the transactional key, not MCP key)
# Register sender: Brevo → Senders → Add and verify your domain/email
# BREVO_API_KEY=
# EMAIL_FROM=          ← verified sender email (e.g. noreply@yourdomain.com)
# EMAIL_FROM_NAME=Studio CAS   ← optional, default "Studio CAS"

# Lawyer notifications (choose one or both)
# Telegram Bot: get token from @BotFather, store lawyer chat_id in DB
# TELEGRAM_BOT_TOKEN=
# WhatsApp: via Twilio/MessageBird/360dialog (business verification required)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# Admin API (optional): set to require header x-admin-key on /api/admin/* routes
# ADMIN_API_KEY=

# Auto-translation for services: admin enters content in Italian; system translates to EN, AR, FR (free via MyMemory).
# Optional: set MYMEMORY_EMAIL for higher daily limit (e.g. your@email.com).
# MYMEMORY_EMAIL=
